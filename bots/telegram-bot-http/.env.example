# Required. Add real values before deploying; `neon deploy` and `neon dev` fail while one is missing or empty.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Local only, used by the set:webhook script. Set after you deploy.
TELEGRAM_WEBHOOK_URL=

# Written by `neon link` or `neon env pull` (and refreshed on deploy).
NEON_BRANCH=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
