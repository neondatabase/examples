# Not written by `neon env pull`
# Optional. Defaults to `photos` (the bucket declared in neon.ts), so you can
# leave this unset. Set it only to point at a different bucket.
S3_BUCKET="photos"

# Automatically pulled by `neon env pull`
# Neon Postgres (pooled). Needs the vector + lakebase_vector + lakebase_text extensions.
DATABASE_URL=

# Neon Auth JWKS. The server functions and /api routes verify
# the caller's JWT against this.
NEON_AUTH_JWKS_URL=
NEON_AUTH_BASE_URL=

# Neon Object Storage (S3-compatible), signed with aws4fetch.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=