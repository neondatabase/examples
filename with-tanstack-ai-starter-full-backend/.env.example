# Copy to .env.local and fill in from your Neon project.

# ── Server-side (the app's /api routes) ────────────────────────────────
# Neon Postgres (pooled). Needs the vector + lakebase_vector + lakebase_text extensions.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Auth JWKS. The /api routes verify the caller's JWT against this.
JWKS_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Object Storage (S3-compatible), signed with aws4fetch.
AWS_ENDPOINT_URL_S3="https://<bucket-host>.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_xxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxx"
AWS_REGION="us-east-2"
S3_BUCKET="photos"

# ── Client-side (VITE_ prefix = exposed to the browser) ────────────────
# Neon compute base URL. neon-js derives the Data API + Auth URLs from it.
VITE_NEON_URL="https://ep-xxx.region.aws.neon.tech/neondb"
# Neon Auth base URL (used to fetch the session token for the /api routes).
VITE_NEON_AUTH_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"

# ── Optional: one-click demo account ──────────────────────────────────
# Set both to show a "Try the demo" button on the sign-in page. These are
# public by design (baked into the client bundle), so use a throwaway account.
VITE_DEMO_EMAIL=""
VITE_DEMO_PASSWORD=""
