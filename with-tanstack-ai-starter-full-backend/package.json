{
  "private": true,
  "type": "module",
  "name": "with-tanstack-ai-starter-full-backend",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "presetup": "npm run prefaces",
    "setup": "dotenvx run -- tsx scripts/setup.ts",
    "db:push": "dotenvx run -- drizzle-kit push",
    "seed": "dotenvx run -- tsx scripts/seed.ts",
    "prefaces": "npm i --no-save --no-package-lock @tensorflow/tfjs-node@^4.22.0",
    "faces": "dotenvx run -- tsx scripts/faces.ts",
    "index": "dotenvx run -- tsx scripts/create-index.ts",
    "caption": "dotenvx run -- tsx scripts/caption.ts",
    "search": "dotenvx run -- tsx scripts/search.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "@neondatabase/auth-ui": "^0.3.0-beta",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@vladmandic/human": "^3.3.6",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@neon/config": "^0.9.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "nitro": "npm:nitro-nightly@latest",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-font": "^0.3.2"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
