{
  "name": "with-graphql",
  "description": "GraphQL API using GraphQL Yoga on Hono, backed by Neon Postgres and Drizzle ORM, deployed as a Neon Function.",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "dev": "neon dev",
    "deploy": "neon deploy --env .env.local",
    "endpoint": "neon functions get graphql"
  },
  "type": "module",
  "dependencies": {
    "@neon/config": "^0.9.1",
    "@neon/env": "^0.11.0",
    "@neon/functions": "^0.8.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.13.0",
    "hono": "^4.4.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.3"
  }
}
