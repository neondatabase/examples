# Injected by `neon env pull` once the branch's Postgres is provisioned.
NEON_BRANCH="main"
DATABASE_URL="postgresql://user:password@ep-xxx-xxx-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional: lock down which origin may call the function from the browser.
# Defaults to "*". Set to your deployed SPA origin in production.
# WEB_ORIGIN="https://your-spa.vercel.app"
