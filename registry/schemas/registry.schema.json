{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://neon.com/functions/registry/schemas/registry.schema.json",
	"title": "Neon Function Registry index",
	"type": "object",
	"required": ["templates"],
	"properties": {
		"$schema": { "type": "string" },
		"name": { "type": "string" },
		"homepage": { "type": "string", "format": "uri" },
		"templates": {
			"type": "array",
			"maxItems": 500,
			"items": {
				"type": "object",
				"required": ["id", "title", "description", "path", "categories"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
					"provider": { "type": "string" },
					"title": { "type": "string", "minLength": 1 },
					"description": { "type": "string", "minLength": 1 },
					"categories": {
						"type": "array",
						"minItems": 1,
						"maxItems": 16,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 64,
							"pattern": "^[a-z0-9][a-z0-9-]*$"
						},
						"description": "Display-only source label: first-party, partner, or community. Topical labels such as ai or bots go in the template's template.json. The CLI ignores them."
					},
					"path": {
						"type": "string",
						"maxLength": 255,
						"description": "Path to the template's template.json, relative to this index."
					},
					"logo": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://",
						"maxLength": 2048,
						"description": "Display-only logo. The CLI never fetches it."
					},
					"logoDark": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://",
						"maxLength": 2048,
						"description": "Display-only logo for dark backgrounds. Listings fall back to logo when it is unset. The CLI never fetches it."
					},
					"website": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://",
						"maxLength": 2048,
						"description": "Display-only partner site. The CLI never fetches it."
					}
				}
			}
		}
	}
}
