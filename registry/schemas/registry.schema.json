{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://neon.com/functions/registry/schemas/registry.schema.json",
	"title": "Neon Function Registry index",
	"type": "object",
	"required": ["templates"],
	"properties": {
		"$schema": { "type": "string" },
		"name": { "type": "string" },
		"homepage": { "type": "string", "format": "uri" },
		"templates": {
			"type": "array",
			"maxItems": 500,
			"items": {
				"type": "object",
				"required": ["id", "title", "description", "path"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
					"provider": { "type": "string" },
					"title": { "type": "string", "minLength": 1 },
					"description": { "type": "string", "minLength": 1 },
					"path": {
						"type": "string",
						"maxLength": 255,
						"description": "Path to the template's template.json, relative to this index."
					},
					"logo": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://",
						"maxLength": 2048,
						"description": "Display-only logo. The CLI never fetches it."
					}
				}
			}
		}
	}
}
