# All of these are injected by `neon dev` and written by `neon env pull`
# (from the `neon.ts` policy + your linked branch). You normally don't edit them by hand.

NEON_BRANCH="main"

# Postgres (always present)
DATABASE_URL="postgresql://user:password@ep-xxx-xxx-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx-xxx.region.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon object storage (preview.buckets) — read automatically by the AWS S3 client
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_ENDPOINT_URL_S3="https://<branch-id>.storage.c-3.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"

# Neon AI Gateway (preview.aiGateway) — the @neon/ai-sdk-provider reads these and
# appends the /ai-gateway/<dialect>/… routes itself.
NEON_AI_GATEWAY_TOKEN="nt_live_..."
NEON_AI_GATEWAY_BASE_URL="https://<branch-id>-api.ai.c-3.us-east-2.aws.neon.tech"
