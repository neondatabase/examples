# Pulled from the linked Neon branch by `neon link` / `neon env pull`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Only present when AI Gateway is enabled; not needed in mock mode.
NEON_AI_GATEWAY_BASE_URL="https://<branch-id>-api.ai.<region>.aws.neon.tech"
NEON_AI_GATEWAY_TOKEN="nt_live_..."

# Add a long random secret to .env.local before `neon deploy --env .env.local`.
# Clients send it as Authorization: Bearer <SEARCH_API_KEY>.
SEARCH_API_KEY="replace-with-a-long-random-secret"

# Set to mock for local/deployment smoke tests without AI Gateway access.
# Omit or set to gateway for real embeddings. Mock vectors have no semantic meaning.
EMBEDDING_PROVIDER="gateway"
