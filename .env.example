# Long random string (for example from openssl rand -base64 32) that signs in to /admin and the upload API. Keep it in a password manager.
ADMIN_TOKEN=

# Name shown as "<name> sent you" on shared links. Defaults to Someone; you can also change it later under Settings in /admin.
OWNER_NAME=

# Site name shown in the interface. Defaults to jalco-drop.
SITE_NAME=

# Accent colour as a hex value such as #ff4f00.
ACCENT_COLOR=

# Code highlighting theme, such as pierre-dark, vesper or github-dark.
CODE_THEME=

# Where visitors to the bare URL are redirected. Defaults to https://www.google.com/.
HOME_URL=

# Object Storage bucket for drops. Defaults to drops.
DROPS_BUCKET=

# Set to off to disable the 60-requests-a-minute limit per IP, for example in tests.
RATE_LIMIT=
