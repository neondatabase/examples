{
  "name": "with-realtime-kysely",
  "description": "Framework-free TypeScript app using Neon Realtime and Kysely.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "db:setup": "tsx src/setup.ts",
    "dev": "tsx src/dev.ts",
    "fmt": "prettier --write .",
    "start": "NODE_ENV=production node dist-server/src/server.js",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@neon/env": "^1.5.3",
    "@neon/realtime": "^0.1.0",
    "@neon/realtime-kysely": "^0.1.0",
    "dotenv": "^17.2.3",
    "kysely": "^0.29.6",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
