# Postgres connection string for a Neon branch with Realtime enabled, from
# Connect in the Neon Console. Keep sslmode=verify-full: pg-connection-string
# prints a SECURITY WARNING for sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Realtime secret and URL, from the Realtime page in the Neon Console. The
# secret seals queries on the server and must never reach the browser. The
# URL is inlined into the browser bundle at build time, so rebuild after it
# changes, and build once per Neon branch.
NEON_REALTIME_SECRET="nrt_live_..."
VITE_NEON_REALTIME_URL="wss://br-xxx-xxx-neonrealtimesocket.compute.region.aws.neon.tech/"

# Neon AI Gateway (paid Neon project in a supported region)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Optional model overrides
# LIVEBASE_EXTRACTION_MODEL=neon/claude-haiku-4-5
# LIVEBASE_ENRICHMENT_MODEL=neon/claude-sonnet-5
# Optional enrichment prices in USD per million tokens, for the run's cost cap.
# The defaults are Sonnet 5's; set them when you change the enrichment model.
# LIVEBASE_ENRICHMENT_PRICE_INPUT=2
# LIVEBASE_ENRICHMENT_PRICE_OUTPUT=10
# LIVEBASE_ENRICHMENT_PRICE_CACHE_READ=0.2
# LIVEBASE_ENRICHMENT_PRICE_CACHE_WRITE=2.5
# Optional enrichment keys. A tool whose key is missing isn't registered.
# Exa search, needed to find the employer for name-only and LinkedIn-only leads
EXA_API_KEY=
# X API v2 bearer token for X avatars; its tier must allow user lookup by username
X_BEARER_TOKEN=
# Full Gravatar profiles; without it, only the public avatar URL is used
GRAVATAR_API_KEY=
# Brandfetch Logo API client ID, used in the browser for company logos
VITE_BRANDFETCH_CLIENT_ID=
