{
  "name": "with-realtime-react-native",
  "version": "1.0.0",
  "description": "React Native todo app using Neon Realtime, Expo, Hono RPC, and Drizzle ORM.",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "db:push": "drizzle-kit push",
    "db:setup": "npm run db:push && tsx src/setup.ts",
    "dev:server": "tsx watch src/server.ts",
    "fmt": "prettier --write .",
    "ios": "expo run:ios",
    "start": "expo start",
    "start:server": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.5.3",
    "@neon/realtime": "^0.1.0",
    "@neon/realtime-drizzle": "^0.1.0",
    "@neon/realtime-react": "^0.1.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "expo": "~58.0.6",
    "expo-crypto": "~58.0.5",
    "expo-status-bar": "~58.0.3",
    "hono": "^4.13.13",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.14.1",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-safe-area-context": "~5.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "~19.3.0",
    "drizzle-kit": "^0.31.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
