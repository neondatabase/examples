# Written to .env.local by `neon env pull` after `neon deploy` enables Realtime.

# Neon branch this directory is linked to.
NEON_BRANCH="main"
# Pooled Postgres connection string, used by the server and drizzle-kit.
DATABASE_URL="postgresql://user:password@ep-xxx-xxx-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct Postgres connection string. This example doesn't use it.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx-xxx.region.neon.tech/neondb?sslmode=require&channel_binding=require"
# Realtime WebSocket URL. The server sends it to the browser.
NEON_REALTIME_URL="wss://your-realtime-endpoint"
# Realtime secret the server uses to seal queries. Keep it out of the browser.
NEON_REALTIME_SECRET="nrt_live_..."
