{
  "name": "with-realtime-react",
  "description": "Fully typed React app using Neon Realtime, Hono RPC, and Drizzle ORM.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "db:push": "drizzle-kit push",
    "db:setup": "npm run db:push && tsx src/setup.ts",
    "dev": "tsx watch src/dev.ts",
    "fmt": "prettier --write .",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.5.3",
    "@neon/realtime": "^0.1.0",
    "@neon/realtime-drizzle": "^0.1.0",
    "@neon/realtime-react": "^0.1.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.14.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
