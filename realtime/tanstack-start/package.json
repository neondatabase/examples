{
  "name": "with-realtime-todos-tanstack-start",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js build && tsc --noEmit",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx src/setup.ts",
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js dev",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "sdk:local": "node scripts/local-sdk.mjs",
    "realtime:env": "neon env pull --service postgres --service realtime --file .env.local && node scripts/realtime-env.mjs",
    "fmt": "prettier --write ."
  },
  "dependencies": {
    "@neon/realtime": "0.0.1",
    "@neon/realtime-drizzle": "0.0.1",
    "@neon/realtime-tanstack": "0.0.1",
    "@tanstack/db": "0.9.0",
    "@tanstack/react-db": "0.3.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-with-db": "0.1.0",
    "@tanstack/react-start": "1.168.54",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "^3.0.260311-beta",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^8.0.14",
    "@neon/config": "file:.sdk/neon-config.tgz",
    "@neon/sdk": "file:.sdk/neon-sdk.tgz"
  },
  "description": "Neon Realtime todo example with TanStack Start SSR and TanStack DB optimistic mutations.",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@tanstack/router-core": "1.171.30"
  }
}
