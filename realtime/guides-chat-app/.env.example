# Written to .env.local by `neon deploy` (or `neon env pull`) once neon.ts has enabled Neon Auth and Realtime on the branch.
# Postgres connection strings, from the Neon Console: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# The unpooled string and the branch name are written too; this app doesn't read them.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_BRANCH="main"
# Neon Auth URL. vite.config.ts exposes it to the browser as VITE_NEON_AUTH_URL; backend/auth.ts derives the JWKS URL from it.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# Realtime Live SQL API URL. vite.config.ts exposes it to the browser as VITE_NEON_REALTIME_URL.
NEON_REALTIME_URL="wss://br-xxx-neonrealtimesocket.compute.region.aws.neon.tech/"
# Realtime secret for sealing queries. Server-only: never give it a VITE_ prefix.
NEON_REALTIME_SECRET="nrt_live_..."
