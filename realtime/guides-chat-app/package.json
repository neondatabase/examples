{
  "name": "with-realtime-guides-chat-react",
  "description": "The chat app from the Neon Realtime guides: React, Managed Better Auth, live queries, a TanStack DB inbox, Hono and Drizzle.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "db:push": "drizzle-kit push",
    "db:setup": "npm run db:push && tsx backend/setup.ts",
    "dev": "tsx watch --clear-screen=false --include .env.local backend/dev.ts",
    "fmt": "prettier --write .",
    "start": "tsx backend/server.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "worker": "tsx backend/worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth-ui/core": "^1.7.30",
    "@better-auth-ui/react": "^1.7.30",
    "@hono/node-server": "^1.19.7",
    "@neon/auth": "^0.8.1",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "@neon/realtime": "^0.1.0",
    "@neon/realtime-drizzle": "^0.1.0",
    "@neon/realtime-react": "^0.1.0",
    "@neon/realtime-tanstack": "^0.1.0",
    "@tanstack/react-db": "0.5.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "~1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.12",
    "jose": "^6.2.12",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.6",
    "prettier": "^3.6.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "@neon/realtime-tanstack": {
      "@tanstack/db": "0.12.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
