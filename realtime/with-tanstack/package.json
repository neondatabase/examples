{
  "name": "with-realtime-tanstack",
  "description": "SSR TanStack Start and TanStack DB app using Neon Realtime and Drizzle ORM.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:setup": "npm run db:push && tsx src/setup.ts",
    "dev": "vite dev",
    "fmt": "prettier --write .",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neon/env": "^1.5.3",
    "@neon/realtime": "0.0.1",
    "@neon/realtime-drizzle": "0.0.1",
    "@neon/realtime-tanstack": "0.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/db": "0.9.0",
    "@tanstack/react-db": "0.3.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-with-db": "0.1.0",
    "@tanstack/react-start": "1.168.54",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "^0.31.6",
    "nitro": "^3.0.260311-beta",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.0.14"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@tanstack/router-core": "1.171.30"
  }
}
