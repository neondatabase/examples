# Written by `neon env pull` after Realtime and Neon Auth are deployed.
DATABASE_URL="postgresql://user:password@ep-xxx-xxx-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_REALTIME_URL="wss://your-realtime-endpoint"
NEON_REALTIME_SECRET="nrt_live_..."
# NEON_AUTH_BASE_URL="https://ep-....neonauth.c-3.us-east-2.aws.neon.tech/neondb/auth"

# Not written by `neon env pull`. Append these to .env.local yourself; don't
# copy this file over it.
#
# Signs the Neon Auth session cookie. At least 32 characters, e.g. from
# `openssl rand -base64 32`.
# NEON_AUTH_COOKIE_SECRET="..."
#
# The browser's Realtime URL. Vite expands $NEON_REALTIME_URL, so it follows
# the pulled value when you switch branches.
# VITE_NEON_REALTIME_URL=$NEON_REALTIME_URL
