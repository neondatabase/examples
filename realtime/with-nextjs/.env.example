# Written to .env.local by `neon deploy` (first run) or `neon env pull`, once Managed Better Auth and Realtime are enabled.
DATABASE_URL="postgresql://user:password@ep-xxx-xxx-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
# Also written by the pull. This app doesn't use it (it checks sessions with cookies, not JWTs).
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_REALTIME_URL="wss://your-realtime-endpoint"
NEON_REALTIME_SECRET="nrt_live_..."
# NOT written by the pull. Append it yourself, 32+ characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-32-or-more-random-characters"
