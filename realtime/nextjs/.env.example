# Postgres connection strings written by neon link / neon env pull.
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.build/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.build/neondb?sslmode=require"

# Server-only Realtime secret written by neon env pull. Never expose it in a public variable.
NEON_REALTIME_SECRET="nrt_live_1replace-with-your-project-secret"

# Realtime database name and WebSocket URL written by neon env pull.
NEON_REALTIME_DATABASE_NAME="neondb"
NEON_REALTIME_URL="wss://br-example-neonrealtimesocket.compute.c-1.us-east-2.aws.neon.build/"

# Public URL copied by npm run realtime:env. The secret stays server-only.
NEXT_PUBLIC_NEON_REALTIME_URL="wss://br-example-neonrealtimesocket.compute.c-1.us-east-2.aws.neon.build/"
